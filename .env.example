# Copy to .env for local use. A real environment variable wins over this file.
# Reference: _docs/tech/practices.md section 1.

# Run mode: dev, test or prod
SPLITWISE_ENV=dev
# Path of the SQLite file
SPLITWISE_DATABASE_PATH=_data/splitwise.db
# Key that signs sign-in tokens. Required when SPLITWISE_ENV is prod. Never commit a real key.
SPLITWISE_SECRET_KEY=dev-secret-change-me
# Minimum log level: DEBUG, INFO, WARNING, ERROR
SPLITWISE_LOG_LEVEL=INFO
# Log renderer: console or json. Default: console in dev, json otherwise.
SPLITWISE_LOG_FORMAT=console
# Address and port that the server binds to
SPLITWISE_HOST=127.0.0.1
SPLITWISE_PORT=8000
